#!/usr/bin/env bash
# Stand-in for the Atlassian CLI in tests. Logged out unless FAKE_ACLI_LOGGED_IN is set.
if [ -z "$FAKE_ACLI_LOGGED_IN" ]; then
  echo "✗ Error: unauthorized: use 'acli jira auth login' to authenticate" >&2
  exit 1
fi
case "$2 $3" in
  "auth status") printf '✓ Authenticated\n  Site: example.atlassian.net\n  Email: me@example.com\n' ;;
  "auth logout") echo "✓ Logged out" ;;
  *) echo "{}" ;;
esac
