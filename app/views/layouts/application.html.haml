!!!
%html{ lang: "en" }
  %head
    %title= content_for(:title) || "Echo"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    = csrf_meta_tags
    = csp_meta_tag
    :javascript
      try {
        const saved = localStorage.getItem("echo.theme") || "system";
        const dark = saved === "dark" || (saved === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      } catch {}
    %link{ rel: "icon", href: favicon_path, type: "image/svg+xml" }
    = vite_client_tag
    = vite_typescript_tag "application"
  %body
    = yield
